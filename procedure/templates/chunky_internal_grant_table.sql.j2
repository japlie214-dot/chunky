CREATE OR REPLACE PROCEDURE chunky_internal_grant_table(
    db VARCHAR,
    schema VARCHAR,
    table_name VARCHAR,
    roles VARIANT
)
RETURNS VARIANT
LANGUAGE PYTHON
RUNTIME_VERSION = '{{PYTHON_RUNTIME}}'
IMPORTS = ('{{LIB_STAGE}}/{{UTILS_BUNDLE}}')
PACKAGES = ('snowflake-snowpark-python')
